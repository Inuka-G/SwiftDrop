# Copy to ".env" (never commit .env) and change the values.
# docker compose also works with NO .env file: every value below has a dev default.

# --- PostgreSQL ---
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=change_me_postgres

# --- RabbitMQ ---
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=change_me_rabbit

# --- Backend ---
# Development = seeds sample data (e.g. pricing zones). Use Production for a clean DB.
ASPNETCORE_ENVIRONMENT=Development

# --- Host ports on your machine ---
BACKEND_PORT=5017
FRONTEND_PORT=5173

# --- Add when the owners of those modules finalise the setting names ---
# Jwt__Key=change_me_to_a_long_random_string_32chars_min
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
