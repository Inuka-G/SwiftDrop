{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SwiftDrop",
    "Audience": "SwiftDrop.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Google": {
      "FrontendCallbackUrl": "http://localhost:5173/auth/google/callback"
    }
  }
}
