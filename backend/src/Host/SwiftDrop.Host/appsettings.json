{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=swiftdrop;Username=postgres;Password=postgres;Include Error Detail=true;"
  },
  "Jwt": {
    "Issuer": "SwiftDrop",
    "Audience": "SwiftDrop.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Google": {
      "FrontendCallbackUrl": "http://localhost:5173/auth/google/callback"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Exchange": "swiftdrop.events"
  }
}
